{
    // Appearance
    "editor.fontSize": 14,
    "editor.fontLigatures": false,
    "editor.fontFamily": "'Iosevka Nerd Font', 'CaskaydiaCove Nerd Font Light', 'Fira Code', Consolas, 'Courier New', monospace",
    "apc.parts.font.family": {
        "sidebar": "'Iosevka Nerd Font', 'CaskaydiaCove Nerd Font Light', 'Fira Code', Consolas, 'Courier New', monospace",
        "titlebar": "'Iosevka Nerd Font', 'CaskaydiaCove Nerd Font Light', 'Fira Code', Consolas, 'Courier New', monospace",
        "activityBar": "'Iosevka Nerd Font', 'CaskaydiaCove Nerd Font Light', 'Fira Code', Consolas, 'Courier New', monospace",
        "panel": "'Iosevka Nerd Font', 'CaskaydiaCove Nerd Font Light', 'Fira Code', Consolas, 'Courier New', monospace",
        "tabs": "'Iosevka Nerd Font', 'CaskaydiaCove Nerd Font Light', 'Fira Code', Consolas, 'Courier New', monospace",
        "statusbar": "'Iosevka Nerd Font', 'CaskaydiaCove Nerd Font Light', 'Fira Code', Consolas, 'Courier New', monospace",
        "settings-body": "'Iosevka Nerd Font', 'CaskaydiaCove Nerd Font Light', 'Fira Code', Consolas, 'Courier New', monospace",
        "extension-editor": "'Iosevka Nerd Font', 'CaskaydiaCove Nerd Font Light', 'Fira Code', Consolas, 'Courier New', monospace"
    },
    "workbench.colorTheme": "Catppuccin Frappé",
    "catppuccin.accentColor": "blue",
    "workbench.iconTheme": "material-icon-theme",
    // Editor
    "editor.lineNumbers": "relative",
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": true,
    "editor.wordWrap": "off",
    "editor.minimap.enabled": false,
    "editor.cursorBlinking": "solid",
    "editor.stickyScroll.enabled": false,
    "editor.guides.indentation": true,
    "editor.renderWhitespace": "selection",
    "editor.formatOnSave": true,
    "editor.acceptSuggestionOnEnter": "off",
    "editor.codeLens": false,
    "editor.inlayHints.enabled": "offUnlessPressed",
    // Vim: editing only, no leader mappings
    "vim.useSystemClipboard": true,
    "vim.hlsearch": true,
    "vim.incsearch": true,
    "vim.smartRelativeLine": true,
    // Workbench
    "workbench.startupEditor": "none",
    "workbench.sideBar.location": "right",
    "workbench.activityBar.location": "bottom",
    "workbench.editor.showTabs": "none",
    "workbench.editor.editorActionsLocation": "titleBar",
    // Files
    "files.autoSave": "off",
    // Language-specific settings
    "[cpp]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
    },
    // Vim keybind
    "vim.normalModeKeyBindingsNonRecursive": [
        {
            "before": [
                "K"
            ],
            "commands": [
                "editor.action.showHover"
            ]
        }
    ],
    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "explorer.confirmPasteNative": false,
    "explorer.confirmDragAndDrop": false,
    "makefile.configureOnOpen": true
}